# Enable mod_rewrite and force SPA fallback to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the requested file or directory exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite to index.html so the SPA router can handle the route
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: disable directory listing
Options -Indexes
